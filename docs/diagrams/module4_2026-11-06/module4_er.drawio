geometry" /></mxCell><mxCell id="02_changes-31" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="加入来源：组装作业与维护二选一；移出来源也分别二选一。"><mxGeometry x="65" y="773.95" width="474.00000000000006" height="22.1" as="geometry" /></mxCell><mxCell id="02_changes-32" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="来源已知时恰有一个主要来源；历史来源缺失时，必须记录缺失理由。"><mxGeometry x="65" y="800.95" width="542.0" height="22.1" as="geometry" /></mxCell><mxCell id="02_changes-33" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="尚未移出的安装不设移出来源；执行来源和成员安装必须属于同一组。"><mxGeometry x="65" y="827.95" width="542.0" height="22.1" as="geometry" /></mxCell><mxCell style="endArrow=none;startArrow=none;rounded=0;strokeColor=#cbd5de;strokeWidth=1.8;" id="02_changes-34" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="175" as="sourcePoint" /><mxPoint x="1160" y="865" as="targetPoint" /></mxGeometry></mxCell><mxCell id="02_changes-35" parent="1" vertex="1" style="shape=rectangle;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2f8;strokeColor=#57748d;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=18;fontStyle=1;" value="实际组装作业&lt;br&gt;AssemblyJob"><mxGeometry x="1210.0" y="254.0" width="220" height="72" as="geometry" /></mxCell><mxCell id="02_changes-36" parent="1" vertex="1" style="shape=rectangle;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2f8;strokeColor=#57748d;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=18;fontStyle=1;" value="实际维护事件&lt;br&gt;MaintenanceEvent"><mxGeometry x="1505.0" y="254.0" width="230" height="72" as="g