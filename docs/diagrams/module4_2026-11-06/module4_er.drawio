shape=rectangle;html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=16;fontStyle=0;" value="0..N"><mxGeometry x="1470.0" y="778.5" width="60" height="27" as="geometry" /></mxCell><mxCell id="01_core-45" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="“成员安装”表示某单元在某组的一次安装发生。"><mxGeometry x="690" y="338.95" width="389.0" height="22.1" as="geometry" /></mxCell><mxCell id="01_core-46" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="同组同单元可再次安装，以“安装发生序次”区分。"><mxGeometry x="690" y="365.95" width="406.0" height="22.1" as="geometry" /></mxCell><mxCell id="01_core-47" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="维护目标从“生命周期事件”继承，详见第 4 页。"><mxGeometry x="700" y="913.95" width="389.918" height="22.1" as="geometry" /></mxCell><mxCell id="01_core-48" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="“经历维护”仅展示继承后的目标约束，不另存一份目标。"><mxGeometry x="700" y="940.95" width="457.00000000000006" height="22.1" as="geometry" /></mxCell><mxCell id="01_core-49" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="基数读法：固定对端一个实例，端点标注表示此端可以对应多少个实例（沿用 LN3 课程读法）。"><mxGeometry x="65" y="988.95" width="733.3520000000001" height="22.1" as="geometry" /></mxCell><mxCell id="01_core-50" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="例如：一个电池组可有零到多次组装作业；每次组装作业针对且仅针对一个电池组。"><mxGeometry x="65" y="1015.95" width="644.0" height="22.1" as="geometry" /></mxCell><mxCell id="01_core-51" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="图例：矩形＝实体；矩形内含菱形＝关联实体；菱形＝联系；灰色虚线框＝共享实体。0..N 表示零到多。"><mxGeometry x="65" y="1042.95" width="798.666" height="22.1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="module4-1" name="第 2 页 / 成员变化"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="02_changes-0" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=15;fontColor=#566879;fontStyle=0;" value="G22 / 第四板块：组包与维护 / 概念设计"><mxGeometry x="55" y="32.25" width="282.81" height="19.5" as="geometry" /></mxCell><mxCell id="02_changes-1" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=30;fontColor=#20354a;fontStyle=1;" value="成员变化来源与检查触发"><mxGeometry x="55" y="62.5" width="345.0" height="39.0" as="geometry" /></mxCell><mxCell id="02_changes-2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="本页复用同一组实体；加入来源和移出来源分别记录，分别满足互斥规则。"><mxGeometry x="55" y="107.95" width="576.0" height="22.1" as="geometry" /></mxCell><mxCell style="endArrow=none;startArrow=none;roun