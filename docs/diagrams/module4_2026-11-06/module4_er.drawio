a;fontSize=18;fontStyle=1;" value="电池组&lt;br&gt;BatteryPack"><mxGeometry x="1385.0" y="784.0" width="250" height="72" as="geometry" /></mxCell><mxCell id="04_shared-39" parent="1" vertex="1" style="shape=rhombus;html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#57748d;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=18;fontStyle=0;" value="以组为目标"><mxGeometry x="1072.5" y="776.0" width="215" height="88" as="geometry" /></mxCell><mxCell style="endArrow=none;startArrow=none;rounded=0;strokeColor=#57748d;strokeWidth=1.8;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" id="04_shared-40" parent="1" edge="1" source="04_shared-28" target="04_shared-39"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="820" as="sourcePoint" /><mxPoint x="1072.5" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="04_shared-41" parent="1" vertex="1" style="shape=rectangle;html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=16;fontStyle=0;" value="0..N"><mxGeometry x="1000.0" y="771.5" width="60" height="27" as="geometry" /></mxCell><mxCell style="endArrow=none;startArrow=none;rounded=0;strokeColor=#57748d;strokeWidth=1.8;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" id="04_shared-42" parent="1" edge="1" source="04_shared-39" target="04_shared-38"><mxGeometry relative="1" as="geometry"><mxPoint x="1287.5" y="820" as="sourcePoint" /><mxPoint x="1385" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="04_shared-43" parent="1" vertex="1" style="shape=rectangle;html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=16;fontStyle=0;" value="0..1"><mxGeometry x="1305.0" y="771.5" width="60" height="27" as="geometry" /></mxCell><mxCell id="04_shared-44" parent="1" vertex="1" style="shape=ellipse;html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#57748d;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=20;fontStyle=0;" value=""><mxGeometry x="828.0" y="908.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="04_shared-45" parent="1" vertex="1" style="shape=rectangle;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2f8;strokeColor=#57748d;strokeWidth=1.8;fontFamily=PingFang SC;fontColor=#20354a;fontSize=18;fontStyle=1;" value="实际维护事件&lt;br&gt;MaintenanceEvent"><mxGeometry x="715.0" y="994.0" width="270" height="72" as="geometry" /></mxCell><mxCell style="endArrow=none;startArrow=none;rounded=0;strokeColor=#57748d;strokeWidth=1.8;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" id="04_shared-46" parent="1" edge="1" source="04_shared-28" target="04_shared-44"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="856" as="sourcePoint" /><mxPoint x="850" y="908" as="targetPoint" /></mxGeometry></mxCell><mxCell style="endArrow=none;startArrow=none;rounded=0;strokeColor=#57748d;strokeWidth=1.8;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" id="04_shared-47" parent="1" edge="1" source="04_shared-44" target="04_shared-45"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="952" as="sourcePoint" /><mxPoint x="850" y="994" as="targetPoint" /></mxGeometry></mxCell><mxCell id="04_shared-48" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=18;fontColor=#20354a;fontStyle=0;" value="是一种（ISA）：部分特化，以单线表示"><mxGeometry x="925" y="873.3" width="329.35200000000003" height="23.400000000000002" as="geometry" /></mxCell><mxCell id="04_shared-49" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="维护继承父事件的标识及通用业务事实。"><mxGeometry x="1140" y="918.95" width="321.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-50" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="维护子类型：恰有一个组目标和一个主要执行组织。"><mxGeometry x="1140" y="945.95" width="406.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-51" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="其他通用事件也可能以电池单元为目标。"><mxGeometry x="1140" y="972.95" width="321.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-52" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="本页只展示维护子类；全局互斥或重叠尚待确认。"><mxGeometry x="1140" y="999.95" width="389.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-53" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="其他新增对象暂不自动加入这一继承结构。"><mxGeometry x="1140" y="1026.95" width="338.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-54" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="父事件通用事实：时间、目标、参与方和数据来源。"><mxGeometry x="65" y="996.95" width="406.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-55" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="组级目标支持及角色规则须与第一板块共同确认。"><mxGeometry x="65" y="1023.95" width="389.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-56" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="电池组所有权沿用共享资产登记的定义；"><mxGeometry x="65" y="1050.95" width="321.0" height="22.1" as="geometry" /></mxCell><mxCell id="04_shared-57" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#566879;fontStyle=0;" value="本视图暂不规定所有权的数量关系。"><mxGeometry x="65" y="1077.95" width="287.0" height="22.1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>